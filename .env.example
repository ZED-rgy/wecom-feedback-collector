# Local persistence
WECOM_DATABASE_PATH=data/feedback.db

# Conversation archive (official Finance SDK integration will use these later)
WECOM_ARCHIVE_ENABLED=false
WECOM_ARCHIVE_CORP_ID=
WECOM_ARCHIVE_SECRET=
WECOM_ARCHIVE_PRIVATE_KEY_PATH=

# One designated customer group
WECOM_TARGET_ROOM_ID=
WECOM_TARGET_GROUP_NAME=
WECOM_TARGET_GROUP_REMARK=

# The employee account whose @mentions should be collected
WECOM_TARGET_ACCOUNT_ID=
WECOM_TARGET_ACCOUNT_NAMES=

# Aggregation and outbound behavior
WECOM_CONTEXT_WINDOW_SECONDS=90
WECOM_SUMMARY_TIMES=12:00,18:00
WECOM_DRY_RUN=true
