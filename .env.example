# Local persistence
WECOM_DATABASE_PATH=data/feedback.db

# Conversation archive (official Finance SDK integration will use these later)
WECOM_ARCHIVE_ENABLED=false
WECOM_ARCHIVE_CORP_ID=
WECOM_ARCHIVE_SECRET=
WECOM_ARCHIVE_PRIVATE_KEY_PATH=

# One designated customer group
WECOM_TARGET_ROOM_ID=
WECOM_TARGET_GROUP_NAME=
WECOM_TARGET_GROUP_REMARK=

# The employee account whose @mentions should be collected
WECOM_TARGET_ACCOUNT_ID=
WECOM_TARGET_ACCOUNT_NAMES=

# Aggregation and outbound behavior
WECOM_CONTEXT_WINDOW_SECONDS=90
# interval: send every N hours inside the active window; fixed: use WECOM_SUMMARY_TIMES
WECOM_SUMMARY_SCHEDULE_MODE=interval
WECOM_SUMMARY_INTERVAL_HOURS=2
WECOM_SUMMARY_ACTIVE_START=08:00
WECOM_SUMMARY_ACTIVE_END=22:00
WECOM_SUMMARY_TIMES=12:00,18:00
WECOM_SUMMARY_DETAIL_LIMIT=5
# Saved by the desktop UI as base64-encoded UTF-8. Blank uses the built-in template.
WECOM_SUMMARY_TEMPLATE_B64=
WECOM_POLL_INTERVAL_SECONDS=10
WECOM_DRY_RUN=true
WECOM_AUTO_SEND_ENABLED=false

# Read the signed-in Windows WeCom account's encrypted local store.
# Read-only process memory; in-memory decrypted snapshots; no DLL injection.
WECOM_LOCAL_DB_ENABLED=false

# Smart-table integration (separate from the Windows employee-account channel)
# Uses the official wecom-cli transport; API URL is optional.
WECOM_TABLE_INTEGRATION_ENABLED=false
WECOM_SMART_TABLE_URL=
WECOM_TABLE_BOT_API_URL=
WECOM_TABLE_BOT_ID=
WECOM_TABLE_BOT_SECRET=
